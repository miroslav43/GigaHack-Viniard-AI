    {
      "dot": "emerald",
      "title": "Rânduri: de la tile la bloc",
      "items": [
        "tile_prep: −a* (Lab, σ 2,5 px) > 4; rows_detect: unghi 2° → 0,5°, pas 1,8–3,8 m, SNR ≥ 3, dreaptă Huber pe bandă 0,35 m.",
        "7.168 candidați, 1.670 acceptați (too_wide 4.338, no_periodicity 559); rows_link adaugă 212 ghidați și 291 din semințe.",
        "blocks: 848 lanțuri → 674 rânduri în 44 de blocuri; drumurile OSM taie rândurile, regularizarea curăță capetele."
      ]
    },
    {
      "dot": "violet",
      "title": "Atribute pe tile",
      "items": [
        "canopy: ExG = 2G − R − B > 25 în coridorul ±0,30 m; axa mutată pe pixelii ExG; plantele lipite se despart la gâtuire.",
        "interrow: benzi exclusive, sub 0,25 vegetație = sol gol, peste 0,75 = vegetație.",
        "row_attrs: capătul nelegat se oprește la ultima plantă + 0,2 m; un gol ≥ 5 m face rândul disrupted."
      ]
    },
    {
      "dot": "amber",
      "title": "AnnSet RC10f",
      "items": [
        "1.508 bucăți de rând · 13.702 plante · 1.330 interrânduri · 11 deșeuri; 0 erori de topologie.",
        "Exemplele r006 + r021: canopy 0,8755 · rows F1 1,0 · interrow IoU 0,960 · atribute 1,0.",
