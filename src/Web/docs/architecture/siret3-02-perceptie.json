  "cards": [
    {
      "dot": "emerald",
      "title": "Rânduri: de la tile la bloc",
      "items": [
        "tile_prep salvează în cache masca de pixeli validi și vegetația Lab −a* > 4; rows_detect găsește unghiul, pasul (1.8–3.8 m) și câte o dreaptă Huber pe rând.",
        "rows_link reia tile-urile cu ≤ 4 rânduri pe rețeaua vecinilor (+127 rânduri în full-v3) și leagă segmentele în UTM (Δθ ≤ 3°, ≤ 0.3 m).",
        "blocks leagă vecinii paraleli la 1.8–4.0 m, plus muchii skip-one, ca un rând lipsă să nu rupă blocul: 54 de blocuri, 717 rânduri."
      ]
    },
    {
      "dot": "violet",
      "title": "Atribute calculate pe tile",
      "items": [
        "canopy: ExG = 2G − R − B > 25 în coridorul ±0.30 m, contururi brute ≥ 0.19 m²; plantele care se ating fuzionează — 11 889 poligoane canopy.",
        "interrow: banda dintre coridoare, clasă după fracția de vegetație; row_attrs: un gol ≥ 5 m face rândul disrupted (51/51 etichete).",
        "waste: candidați HSV pe tile; se exportă doar cele 3 cutii aprobate în waste_confirmed.csv."
      ]
    },
    {
      "dot": "amber",
      "title": "Cache, rulare și AnnSet",
      "items": [
        "Etapele pe tile rulează în pool spawn cu 8 procese; cheia sha1 se scrie ultima, deci o re-rulare refolosește tile-urile neschimbate.",
        "nn_infer e oprit: varianta clasică A are scor canopy 0.816, peste 0.773 al celei mai bune variante NN.",
        "assemble unește cache-urile în AnnSet (0 erori de topologie); export_cvat scrie 5 ZIP-uri CVAT ≤ 85 MB."
      ]
    }
  ]
