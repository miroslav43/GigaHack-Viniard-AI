  "cards": [
    {
      "dot": "cyan",
      "title": "Ce intră în configs/",
      "items": [
        "overrides.yaml: exclude_areas (linia tăiată, se păstrează partea cea mai lungă), force_empty_tiles, delete / extend / add pe rânduri.",
        "row_seeds.csv: poligon + unghi + pas pe tile (tile_id, vines, confidence, polygon_px, angle_deg, spacing_m, kind, note); 197 de semințe.",
        "waste_confirmed.csv: 13 cutii (3 SAM 3 aprobate de echipă + 10 din revizia RC9f); doar ele pot ajunge în export (11 în RC10f).",
        "O excludere care ar tăia un rând la mijloc (copac, drum în vie) nu se aplică automat: merge în lista pentru Marcaj."
      ]
    },
    {
      "dot": "emerald",
      "title": "Cronologia RC",
      "items": [
        "RC7: 5 tile-uri forțat goale după revizie vizuală + prima listă Marcaj.",
        "RC8: X001–X011 din verificarea după cadastru; 33 de semințe din loturile de revizie: 602 → 730 de rânduri.",
        "RC9f: 50 de agenți pe toate tile-urile, apoi 26 pe cele 51 schimbate; 10 deșeuri; listă de 174 de intrări.",
        "RC9g: sămânța de lângă START avea 118,4° în loc de 127,3° (detectorul caută doar ±3°) → unghiul se ia de la rândurile vecine.",
        "RC10: 149 de semințe cadastre_auto căutate pe masca vine-unet. RC10f: 18 agenți pe 36 de tile-uri → 21 de piese (558 m) excluse."
      ]
    },
    {
      "dot": "amber",
      "title": "Reguli ale buclei",
      "items": [
        "Agenții aplică doar corecțiile de încredere mare; tot restul devine sarcină pentru adnotatori.",
        "Fiecare RC nou trece porțile pe cele 2 tile-uri de referință (canopy, rows F1, interrow, atribute) înainte de export.",
        "RC10f a fost ultimul import automat: de acum corecțiile se fac doar manual, în Marcaj."
      ]
    }
