{
  "name": "solemtrix-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "data": "node scripts/build-data.mjs && node scripts/build-terrain.mjs --survey siret3-mock",
    "data:fast": "node scripts/build-data.mjs --skip-ortho && node scripts/build-terrain.mjs --survey siret3-mock",
    "data:survey": "node scripts/build-survey.mjs",
    "data:terrain": "node scripts/build-terrain.mjs",
    "test:scripts": "node --test scripts/survey/*.test.mjs scripts/terrain/*.test.mjs scripts/assistant/*.test.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/inter": "5.3.0",
    "@google/genai": "2.24.0",
    "@mui/icons-material": "9.4.0",
    "@mui/material": "9.4.0",
    "@mui/material-nextjs": "9.4.0",
    "@mui/x-data-grid": "9.14.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "@vis.gl/react-maplibre": "8.1.3",
    "maplibre-gl": "6.11.2",
    "next": "16.3.6",
    "next-intl": "4.14.7",
    "proj4": "2.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/geojson": "7946.0.16",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "fast-xml-parser": "5.11.1",
    "sharp": "0.35.4",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
