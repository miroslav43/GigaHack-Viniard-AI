# Copy to .env.local. Without the Supabase variables the app runs in open demo mode (no login).
NEXT_PUBLIC_SUPABASE_URL=https://htdnuwmnztenevnfahie.supabase.co
# publishable key (sb_publishable_…) — public by design, safe in the browser; never put a secret/service key here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# survey served by the static data build (pnpm data)
NEXT_PUBLIC_SURVEY_ID=siret3-mock
# optional: public URL of the app for the invitation links (default: the host the admin is using).
# It must also be listed in Supabase → Auth → URL Configuration → Redirect URLs.
# SITE_URL=http://localhost:3000
# optional: the in-app assistant. Server-side only — never prefix with NEXT_PUBLIC_. One of:
#   OpenRouter (https://openrouter.ai/keys; model ids: https://openrouter.ai/models?q=gemini) — used when set
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.8-flash
#   or Google directly (https://aistudio.google.com/apikey; https://ai.google.dev/gemini-api/docs/models)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# optional: live tile analysis (/analiza) — server-side only. Defaults: ../../AI, <tmpdir>/vineyard-analiza, uv
# VINEYARD_AI_DIR=../../AI
# ANALIZA_JOBS_DIR=/tmp/vineyard-analiza
# ANALIZA_UV_BIN=uv

# optional: default addresses of the field robot's boards for /robot (local Wi-Fi; the page lets you change them)
# NEXT_PUBLIC_ROBOT_CAM_URL=192.168.1.50
# NEXT_PUBLIC_ROBOT_MOTORS_URL=192.168.1.51
# NEXT_PUBLIC_ROBOT_DRIVE_URL=192.168.1.52
